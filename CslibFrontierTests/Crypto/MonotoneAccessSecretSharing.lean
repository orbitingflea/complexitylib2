module
-- upstream: candidate

public import CslibFrontier.Init
public import CslibFrontier.Crypto.Protocols.SecretSharing.AccessStructure.Additive
public import CslibFrontier.Crypto.Protocols.SecretSharing.AccessStructure.Generic
public import CslibFrontier.Crypto.Protocols.SecretSharing.AccessStructure.Recognition
public import Mathlib.Algebra.Field.ZMod

/-!
# Tests for Coalition Recognition and Generic Monotone Access-Structure Secret Sharing

Concrete checks and counterexample probes for
`CslibFrontier.Crypto.Protocols.SecretSharing.AccessStructure.Recognition` and
`CslibFrontier.Crypto.Protocols.SecretSharing.AccessStructure.Generic` ([BonehShoup2023],
Sections 22.5 and 22.5.1, pp. 975–977):

1. **Construction 22.1 on the access structure of Example 22.1 (`example22_1Access` on `Fin 4` over
   `ZMod 5`):**
   - `example22_1Access.authorizedSets = {{0, 1, 2}, {0, 2, 3}, Finset.univ}` and share dimensions
     `|A^(i)|` equal to `3, 2, 3, 2` for `i = 0, 1, 2, 3` (the minimal-set scheme of Example 22.1
     itself, which shares only over the two 3-element sets and has dimensions `2, 1, 2, 1`, is not
     formalized);
   - reconstruction on all three authorized coalitions and `recognizeCoalitionDist = PMF.pure true`
     on `{0, 1, 2}`;
   - uniform unauthorized views (`genericUniform_viewDist_eq`), acceptance probability `1 / 5` on
     unauthorized `{1, 2, 3}`, and `recognizeCoalitionDist_true_eq_one_iff`.
2. **Hypothesis probes:**
   - `hempty : ¬ A.authorized ∅`: when `∅` is authorized (`AccessStructure.threshold (Fin 2) 0`),
     no scheme over `ZMod 5` is perfectly correct (`not_perfectlyCorrect_of_authorized_empty`), and
     `genericReconstruct` on `∅` returns `0 ≠ 1`;
   - `[Nontrivial Secret]`: when `Secret = Unit` (`|Z| = 1`), `recognizeCoalitionDist` accepts with
     probability `1` even on unauthorized `∅`;
   - `hP : P ∈ scheme.sources`: under `P = PMF.pure 0 ∉ additiveSources 1 (ZMod 5)`, unauthorized
     coalition `{1}` guesses a uniform secret in `ZMod 5` with probability `1`;
   - `hs : ¬ A.authorized s`: on authorized `{0, 1, 2}`, `recognizeCoalitionDist` accepts with
     probability `1 ≠ (5 : ℝ≥0∞)⁻¹`.
-/

public section

namespace CslibFrontierTests.Crypto.MonotoneAccessSecretSharing

open Cslib.Probability Cslib.Probability.PMF
open Cslib.Crypto.Protocols.SecretSharing
open scoped ENNReal

instance : Fact (Nat.Prime 5) := ⟨by decide⟩

/-- The access structure of [BonehShoup2023], Example 22.1 (p. 976) on `Fin 4` (0-indexed for
`{1, 2, 3, 4}`): generated by `{0, 1, 2}` and `{0, 2, 3}`. -/
abbrev example22_1Access : AccessStructure (Fin 4) :=
  AccessStructure.ofSets (({{0, 1, 2}, {0, 2, 3}} : Finset (Finset (Fin 4))) : Set (Finset (Fin 4)))

theorem example22_1Access_not_authorized_empty : ¬ example22_1Access.authorized ∅ := by
  decide

/-- The three authorized coalitions of Example 22.1 are `{0, 1, 2}`, `{0, 2, 3}`, and
`Finset.univ = {0, 1, 2, 3}`. -/
example :
    example22_1Access.authorizedSets = {{0, 1, 2}, {0, 2, 3}, Finset.univ} := by
  decide

/-- Share dimensions `|A^(i)|` in Construction 22.1 on the access structure of Example 22.1: parties
`0` and `2` belong to all `3` authorized coalitions; parties `1` and `3` belong to `2`. -/
example : (example22_1Access.authorizedContaining 0).card = 3 := by decide
example : (example22_1Access.authorizedContaining 1).card = 2 := by decide
example : (example22_1Access.authorizedContaining 2).card = 3 := by decide
example : (example22_1Access.authorizedContaining 3).card = 2 := by decide

/-- Unauthorized coalitions in the access structure of Example 22.1 include `{0, 2}` (`{1, 3}`)
and the 3-party coalition `{1, 2, 3}` (`{2, 3, 4}`). -/
example : ¬ example22_1Access.authorized {0, 2} := by decide
example : ¬ example22_1Access.authorized {1, 2, 3} := by decide

/-- Construction 22.1 instantiated on the access structure of Example 22.1 over `ZMod 5`. -/
noncomputable abbrev example22_1Scheme :
    AccessScheme (ZMod 5) (GenericKey example22_1Access (ZMod 5)) (Fin 4)
      (GenericShare example22_1Access (ZMod 5)) :=
  genericUniformAccessScheme example22_1Access (ZMod 5) example22_1Access_not_authorized_empty

/-- All three authorized coalitions in Example 22.1's access structure reconstruct every secret
`m : ZMod 5`, and `{0, 1, 2}` is accepted with probability `1` by `recognizeCoalitionDist`. -/
example (r : GenericKey example22_1Access (ZMod 5)) (m : ZMod 5) :
    example22_1Scheme.reconstruct {0, 1, 2} (example22_1Scheme.view {0, 1, 2} r m) = m ∧
    example22_1Scheme.reconstruct {0, 2, 3} (example22_1Scheme.view {0, 2, 3} r m) = m ∧
    example22_1Scheme.reconstruct Finset.univ (example22_1Scheme.view Finset.univ r m) = m :=
  ⟨example22_1Scheme.reconstruct_view_eq_secret r m
    (by decide : example22_1Access.authorized {0, 1, 2}),
   example22_1Scheme.reconstruct_view_eq_secret r m
    (by decide : example22_1Access.authorized {0, 2, 3}),
   example22_1Scheme.reconstruct_view_eq_secret r m
    (by decide : example22_1Access.authorized Finset.univ)⟩

example :
    example22_1Scheme.recognizeCoalitionDist
      (uniformOfFintype (GenericKey example22_1Access (ZMod 5))) {0, 1, 2} = PMF.pure true :=
  example22_1Scheme.recognizeCoalitionDist_eq_pure_true_of_authorized _
    (by decide : example22_1Access.authorized {0, 1, 2})

/-- Unauthorized coalition `{1, 2, 3}` in Example 22.1's access structure has uniform views and
acceptance probability `1 / 5` under `recognizeCoalitionDist`. -/
example (m : ZMod 5) :
    example22_1Scheme.viewDist
        (uniformOfFintype (GenericKey example22_1Access (ZMod 5))) {1, 2, 3} m =
      uniformOfFintype ((i : ({1, 2, 3} : Finset (Fin 4))) →
        GenericShare example22_1Access (ZMod 5) i.1) :=
  genericUniform_viewDist_eq example22_1Access (ZMod 5)
    example22_1Access_not_authorized_empty (by decide) m

example :
    example22_1Scheme.recognizeCoalitionDist
        (uniformOfFintype (GenericKey example22_1Access (ZMod 5))) {1, 2, 3} true =
      (5 : ℝ≥0∞)⁻¹ := by
  simpa [ZMod.card 5] using
    example22_1Scheme.recognizeCoalitionDist_true_of_not_authorized (Set.mem_singleton _)
      (s := {1, 2, 3}) (by decide : ¬ example22_1Access.authorized {1, 2, 3})

/-- Probe 1a: When `∅` is authorized (`AccessStructure.threshold (Fin 2) 0`), no sharing and
reconstruction maps over `ZMod 5` can be perfectly correct. -/
example (share : Unit → ZMod 5 → Fin 2 → ZMod 5)
    (reconstruct : (s : Finset (Fin 2)) → ((i : s) → ZMod 5) → ZMod 5) :
    ¬ PerfectlyCorrect (AccessStructure.threshold (Fin 2) 0) share reconstruct :=
  not_perfectlyCorrect_of_authorized_empty (by decide) share reconstruct

/-- Probe 1b: Without `¬ A.authorized ∅`, Construction 22.1's `genericReconstruct` on `∅` sums over
the empty subtype and returns `0 ≠ 1`. -/
example (r : GenericKey (AccessStructure.threshold (Fin 2) 0) (ZMod 5)) :
    genericReconstruct (AccessStructure.threshold (Fin 2) 0) ∅
      (fun j => genericShare (AccessStructure.threshold (Fin 2) 0) r (1 : ZMod 5) j.1) ≠ 1 := by
  have h0 :
      genericReconstruct (AccessStructure.threshold (Fin 2) 0) ∅
        (fun j => genericShare (AccessStructure.threshold (Fin 2) 0) r (1 : ZMod 5) j.1) = 0 := by
    simp [genericReconstruct]
  rw [h0]
  decide

/-- Probe 2: Without `[Nontrivial Secret]` (`|Z| ≥ 2`), `recognizeCoalitionDist` accepts with
probability `1` even on an unauthorized coalition (`Secret = Unit`, `|Z| = 1`). -/
example :
    (additiveUniformAccessScheme 1 Unit).recognizeCoalitionDist
        (uniformOfFintype (Fin 1 → Unit)) ∅ true = 1 ∧
      ¬ (additiveAccessStructure 1).authorized ∅ := by
  have hnot : ¬ (additiveAccessStructure 1).authorized ∅ := by
    rw [additiveAccessStructure_authorized_iff]
    decide
  refine ⟨?_, hnot⟩
  simpa using
    (additiveUniformAccessScheme 1 Unit).recognizeCoalitionDist_true_of_not_authorized
      (Set.mem_singleton _) (s := ∅) hnot

/-- Probe 3: Without `hP : P ∈ scheme.sources`, an unauthorized coalition can guess a uniform secret
with probability `1 ≠ (Fintype.card (ZMod 5) : ℝ≥0∞)⁻¹` (here `P = PMF.pure 0` for `2`-out-of-`2`
additive sharing, where party `1`'s share equals `secret`). -/
example :
    ((uniformOfFintype (ZMod 5)).bind fun secret =>
      ((additiveAccessScheme 1 (ZMod 5)).viewDist (PMF.pure 0) {1} secret).map fun v =>
        decide (v ⟨1, by simp⟩ = secret)) true = 1 := by
  have hview (secret : ZMod 5) :
      ((additiveAccessScheme 1 (ZMod 5)).viewDist (PMF.pure 0) {1} secret).map
          (fun v => decide (v ⟨1, by simp⟩ = secret)) =
        PMF.pure true := by
    rw [AccessScheme.viewDist, AccessStructure.viewDistOf, PMF.map_comp, PMF.pure_map]
    simp [additiveAccessScheme, additiveShare, Cslib.ProbComp.completeShares]
  simp [hview]

/-- Probe 4: On an authorized coalition, `recognizeCoalitionDist` accepts with probability
`1 ≠ (5 : ℝ≥0∞)⁻¹`, and `recognizeCoalitionDist_true_eq_one_iff` characterizes authorization. -/
example :
    example22_1Scheme.recognizeCoalitionDist
        (uniformOfFintype (GenericKey example22_1Access (ZMod 5))) {0, 1, 2} true ≠
      (5 : ℝ≥0∞)⁻¹ := by
  rw [example22_1Scheme.recognizeCoalitionDist_eq_pure_true_of_authorized _
    (by decide : example22_1Access.authorized {0, 1, 2}), PMF.pure_apply_self]
  intro h
  have h1 : (5 : ℝ≥0∞) = 1 := ENNReal.inv_eq_one.mp h.symm
  norm_num at h1

example (s : Finset (Fin 4)) :
    example22_1Scheme.recognizeCoalitionDist
        (uniformOfFintype (GenericKey example22_1Access (ZMod 5))) s true = 1 ↔
      example22_1Access.authorized s :=
  example22_1Scheme.recognizeCoalitionDist_true_eq_one_iff (Set.mem_singleton _) s

end CslibFrontierTests.Crypto.MonotoneAccessSecretSharing
