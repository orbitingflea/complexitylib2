module

public import CslibFrontier.Crypto.Computational.DiscreteLog.SchnorrGroup
import CslibFrontier.Crypto.Computational.CramerShoup.Reductions
import CslibFrontier.Crypto.Computational.ElGamal.Malleability
import Mathlib.Tactic.NormNum.Prime

/-! Clients of the multiplicative ElGamal CCA-insecurity API under module encapsulation: bit
ElGamal is IND-CPA under DDH yet not CCA secure, a concrete instance on a Schnorr group with
advantage exactly `1`, a concrete mauled decryption, and the group-element scheme under the
group-membership predicate that Cramer–Shoup uses. The API under test is imported ordinarily; only
the Schnorr group family is imported publicly, for the fixture `d23`. -/

public section

namespace CslibFrontierTests.Crypto.ElGamalMalleability

open Cslib Cslib.Probability Cslib.Crypto Cslib.Crypto.Encryption
  Cslib.Crypto.PrimeOrderGroupFamily Turing.MultiTapeTM

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

-- For every polynomial-time group family, bit ElGamal is IND-CPA secure under DDH but fails both
-- 1CCA security and interleaved multi-challenge CCA security.
example {F : PrimeOrderGroupFamily} {d : ℕ → F.Desc}
    (hd : ComputableInPolyTime d encUnary F.encDesc) (hDDH : F.DDH (fun n => PMF.pure (d n))) :
    INDCPA (F.elGamalKeyGenProb d) (F.elGamalEncryptProb F.encodeBit d) ∧
      ¬ INDCCA2Of encBool encBits (F.elGamalKeyGenProb d) (F.elGamalEncryptProb F.encodeBit d)
        (F.elGamalDecryptOpt d) ∧
      ¬ INDCCA2InterleavedOf encBool encBits (F.elGamalKeyGenProb d)
        (F.elGamalEncryptProb F.encodeBit d) (F.elGamalDecryptOpt d) :=
  ⟨hDDH.indcpa_elGamalBitEncryptProb, F.not_indcca2Of_elGamalBitEncryptProb hd,
    F.not_indcca2InterleavedOf_elGamalBitEncryptProb hd⟩

-- The hypotheses hold for the constant Schnorr family `fun _ => d23`.
example :
    ¬ INDCCA2Of encBool encBits (schnorrGroups.elGamalKeyGenProb fun _ => d23)
      (schnorrGroups.elGamalEncryptProb schnorrGroups.encodeBit fun _ => d23)
      (schnorrGroups.elGamalDecryptOpt fun _ => d23) :=
  schnorrGroups.not_indcca2Of_elGamalBitEncryptProb (.const d23)

-- On `d23`, the malleability adversary with messages `false` and `true` is strict oracle PPT and
-- has 1CCA advantage exactly `1` at every security parameter.
example : (schnorrGroups.elGamalMaulAdversary schnorrGroups.encodeBit (fun _ => d23)
    (fun _ => false) (fun _ => true)).IsPPT encBool :=
  schnorrGroups.isPPT_elGamalMaulAdversary schnorrGroups.computableInPolyTime_encodeBit
    (.const d23) (.const false) (.const true)

example (n : ℕ) :
    let game (bit : Bool) := ProbComp.eval (cca2GameOn (fun _ _ _ _ => true) encBits
      (schnorrGroups.elGamalKeyGenProb fun _ => d23)
      (schnorrGroups.elGamalEncryptProb schnorrGroups.encodeBit fun _ => d23)
      (schnorrGroups.elGamalDecryptOpt fun _ => d23)
      (schnorrGroups.elGamalMaulAdversary schnorrGroups.encodeBit (fun _ => d23)
        (fun _ => false) (fun _ => true)) bit n)
    Game.advantage (game false) (game true) = 1 :=
  schnorrGroups.advantage_cca2GameOn_elGamalMaulAdversary (fun _ => rfl)
    (schnorrGroups.encodeBit_eq_encode_bitElement d23 false)
    (schnorrGroups.encodeBit_eq_encode_bitElement d23 true)
    ((schnorrGroups.bitElement_injective d23).ne Bool.false_ne_true)

-- A concrete mauled decryption on `d23`: encrypting `g = 2` under the public key `2 ^ 3 = 8` with
-- coin `5` and mauling the ciphertext gives a ciphertext that decrypts to `g + g = 2 * 2 = 4`.
example :
    schnorrGroups.elGamalDecryptDet (fun _ => d23) 0 (encNat 3)
      (schnorrGroups.elGamalMaulCiphertext d23 (encPair encBits encBits
        (schnorrGroups.encodeElGamalEncrypt
          (d23, schnorrGroups.encodeElGamalPublicKey (d23, 3), Nat.bits 2, 5)))) =
      Nat.bits 4 := by
  decide

-- Group-element ElGamal fails 1CCA security under the group-membership admissibility predicate
-- `cramerShoupValid`, under which Cramer–Shoup is CCA secure.
example {F : PrimeOrderGroupFamily} {isElem : F.Desc × List Bool → Bool} {d : ℕ → F.Desc}
    (hd : ComputableInPolyTime d encUnary F.encDesc)
    (hmem : ∀ d x, isElem (d, x) = true ↔ x ∈ Set.range (F.encode d)) :
    ¬ INDCCA2On (F.cramerShoupValid isElem d) encBits encBits (F.elGamalKeyGenProb d)
      (F.elGamalEncryptProb (fun _ m => m) d) (F.elGamalDecryptOpt d) :=
  F.not_indcca2On_elGamalGroupEncryptProb hd fun n _ => by
    rw [cramerShoupValid, Bool.and_eq_true, hmem, hmem]
    exact ⟨⟨_, rfl⟩, ⟨_, rfl⟩⟩

end CslibFrontierTests.Crypto.ElGamalMalleability
