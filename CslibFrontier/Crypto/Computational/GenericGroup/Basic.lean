public import CslibFrontier.Languages.Probabilistic.Basic
public import Mathlib.Algebra.Module.ZMod

/-!
# The group oracle of a generic cyclic group

In the generic group model of [BonehShoup2023], Section 16.3 (p. 693), a cyclic group of order
`q` is reached only through an oracle. The oracle holds an injective *labeling function*
`L : ZMod q → S` and answers two kinds of query. A labeling query `β` gets `L β`. A group operation
`(ℓ₁, ℓ₂, κ₁, κ₂)` gets `L (κ₁ * β₁ + κ₂ * β₂)` when `ℓ₁ = L β₁` and `ℓ₂ = L β₂`, and is rejected
when `ℓ₁` or `ℓ₂` is not a label. The label `L β` stands for the group element `g^β`, so a group
operation computes `(g^β₁)^κ₁ · (g^β₂)^κ₂`.

Groups are written additively, as in `CslibFrontier.Crypto.Computational.DiffieHellman.Finite`:
the book's `g^β` is `β • g` in a `ZMod q`-module.

The book takes `S` to be a set of bit strings with `|S| ≥ q` and lets the oracle choose `L` at
random. Here `S` is any type and `L` is a parameter; a game that draws `L` does so itself, and the
results about `answer` assume of `L` only what they use. The book's `reject` is `none`. The names
`GroupQuery`, `GroupOracleSpec`, `answer`, `groupAnswer` and `GroupQuery.IsProduct` are this
library's.

## Main definitions

* `Cslib.Crypto.GenericGroup.GroupQuery`, `Cslib.Crypto.GenericGroup.GroupOracleSpec`: the
  labeling queries and group operations, and their reply types.
* `Cslib.Crypto.GenericGroup.answer`: the group oracle determined by a labeling `L`.
* `Cslib.Crypto.GenericGroup.groupAnswer`: the group oracle of a `ZMod q`-module with base point
  `g`, whose labels are the group elements.
* `Cslib.Crypto.GenericGroup.GroupQuery.IsProduct`: the group operations that multiply two
  labelled elements. With `OracleComp.QueriesSatisfy` and `OracleComp.IsQueryBounded` it counts
  multiplications in the group, as the book's count for baby-step/giant-step does
  (`CslibFrontier.Crypto.Computational.GenericGroup.BabyStepGiantStep`).

## Main results

* `Cslib.Crypto.GenericGroup.answer_op_label`: the accepting clause of the group operation for an
  injective labeling.
* `Cslib.Crypto.GenericGroup.groupAnswer_eq_answer`: when every element of the group is a multiple
  of `g`, as in a cyclic group of order `q` generated by `g`, the group's oracle is the oracle of
  the labeling `β ↦ β • g`.

## References

* [D. Boneh, V. Shoup, *A Graduate Course in Applied Cryptography*][BonehShoup2023],
  Section 16.3, p. 693, paragraph "Generic groups".
-/

public section

namespace Cslib.Crypto.GenericGroup

variable (q : ℕ) (S : Type)

/-- A query to the group oracle of a generic cyclic group of order `q` with labels in `S`
([BonehShoup2023], Section 16.3, p. 693). -/
inductive GroupQuery where
  /-- Labeling query: ask for the label of `β`. -/
  | label (β : ZMod q)
  /-- Group operation: ask for the label of `κ₁ * β₁ + κ₂ * β₂`, where `ℓᵢ` is the label of
  `βᵢ`. -/
  | op (ℓ₁ ℓ₂ : S) (κ₁ κ₂ : ZMod q)

/-- The reply types of the group oracle: a label for a labeling query, and a label or `none` (the
book's `reject`) for a group operation. -/
abbrev GroupOracleSpec : OracleSpec (GroupQuery q S)
  | .label _ => S
  | .op .. => Option S

variable {q S}

/-- The group oracle determined by the labeling `L`. A labeling query `β` gets `L β`. A group
operation `(ℓ₁, ℓ₂, κ₁, κ₂)` gets `L (κ₁ * β₁ + κ₂ * β₂)` for preimages `L β₁ = ℓ₁` and
`L β₂ = ℓ₂`, which are unique when `L` is injective, and `none` when `ℓ₁` or `ℓ₂` is not a label.
For injective `L` this is the oracle of [BonehShoup2023], Section 16.3 (p. 693). -/
noncomputable def answer (L : ZMod q → S) : (query : GroupQuery q S) → GroupOracleSpec q S query
  | .label β => L β
  | .op ℓ₁ ℓ₂ κ₁ κ₂ =>
      (Function.partialInv L ℓ₁).bind fun β₁ =>
        (Function.partialInv L ℓ₂).map fun β₂ => L (κ₁ * β₁ + κ₂ * β₂)

variable {G : Type} [AddCommGroup G] [Module (ZMod q) G]

variable (q) in
/-- The group oracle of a `ZMod q`-module `G` with base point `g`, whose labels are the elements
of `G`. A labeling query `β` gets `β • g`, the book's `g^β`, and a group operation
`(ℓ₁, ℓ₂, κ₁, κ₂)` gets `κ₁ • ℓ₁ + κ₂ • ℓ₂`; it never rejects. -/
@[expose] def groupAnswer (g : G) : (query : GroupQuery q G) → GroupOracleSpec q G query
  | .label β => β • g
  | .op ℓ₁ ℓ₂ κ₁ κ₂ => some (κ₁ • ℓ₁ + κ₂ • ℓ₂)

/-- The query is a group operation with `κ₁ = κ₂ = 1`: it asks for the product of two labelled
elements, one multiplication in the group. -/
@[expose] def GroupQuery.IsProduct : GroupQuery q S → Prop
  | .op _ _ κ₁ κ₂ => κ₁ = 1 ∧ κ₂ = 1
  | .label _ => False

/-- A labeling query gets the label. -/
@[simp] theorem answer_label (L : ZMod q → S) (β : ZMod q) : answer L (.label β) = L β := by
  dsimp only [answer]

/-- A group operation gets the label of `κ₁ * β₁ + κ₂ * β₂` for preimages `L β₁ = ℓ₁` and
`L β₂ = ℓ₂`, and `none` when there is none. -/
theorem answer_op (L : ZMod q → S) (ℓ₁ ℓ₂ : S) (κ₁ κ₂ : ZMod q) :
    answer L (.op ℓ₁ ℓ₂ κ₁ κ₂) = (Function.partialInv L ℓ₁).bind fun β₁ =>
      (Function.partialInv L ℓ₂).map fun β₂ => L (κ₁ * β₁ + κ₂ * β₂) := by
  dsimp only [answer]

/-- The accepting clause of the group operation ([BonehShoup2023], Section 16.3, p. 693): for an
injective labeling `L`, a group operation on the labels of `β₁` and `β₂` gets the label of
`κ₁ * β₁ + κ₂ * β₂`. -/
theorem answer_op_label {L : ZMod q → S} (hL : Function.Injective L) (β₁ β₂ κ₁ κ₂ : ZMod q) :
    answer L (.op (L β₁) (L β₂) κ₁ κ₂) = some (L (κ₁ * β₁ + κ₂ * β₂)) := by
  dsimp only [answer]
  rw [Function.partialInv_left hL, Function.partialInv_left hL]
  rfl

/-- When every element of `G` is a multiple of `g`, as in a cyclic group of order `q` generated by
`g` ([BonehShoup2023], Section 16.1.1), the oracle of `G` is the generic group oracle of the
labeling `β ↦ β • g`. The labeling need not be injective. -/
theorem groupAnswer_eq_answer {g : G} (hg : Function.Surjective fun β : ZMod q => β • g) :
    groupAnswer q g = answer fun β : ZMod q => β • g := by
  funext query
  cases query with
  | label β => rfl
  | op ℓ₁ ℓ₂ κ₁ κ₂ =>
    have h₁ : ∃ β, β • g = ℓ₁ := hg ℓ₁
    have h₂ : ∃ β, β • g = ℓ₂ := hg ℓ₂
    dsimp only [groupAnswer, answer, Function.partialInv]
    rw [dite_eq_left h₁, dite_eq_left h₂, Option.bind_some, Option.map_some, add_smul, mul_smul,
      mul_smul, Classical.choose_spec h₁, Classical.choose_spec h₂]

end Cslib.Crypto.GenericGroup
