/-!
# Native resource bounds across a classical query

Both stage descriptions are generated by their existing native algorithms. Polynomial bounds on
the original input and on the declared fixed width `t` give one native-computable polynomial bound
for their combined active widths, elementary gates, coherent queries, exact encoded descriptions
and continuation-input length. This theorem does not implement or certify `nextInput`: its
execution time and workspace, program or generator, and static description size are all outside
the budget. The theorem also has no service reply-width bound. Those costs and the reply width
belong to the deferred native compiler tracked by #5281.

The external service is charged as one abstract classical call, not by its computation or reply
size. Its implementation, the preparation of the quantum auxiliary state, and generation of an
ideal random-oracle table are not included. The inaccessible reference contributes no active
qubits.

The width bound is deliberately an upper bound on the sum of the stage widths, hence also on
their peak. The retained memory is part of stage two's quantum input, not an uncharged register.
These are original consequences of the two native generator certificates.

## Main results

* `Cslib.Quantum.UniformOracleCircuitFamily.exists_classicalQuery_resource_bound`:
  native polynomial budgets for two stage descriptions and one abstract classical call.
-/

public section

namespace Cslib.Quantum.UniformOracleCircuitFamily

open Turing.MultiTapeTM

/-- Native generation bounds both stage descriptions and the declared continuation-input length.
It does not compute `nextInput` or charge its execution, program, generator or static size. The
theorem has no service reply-width bound and does not charge service computation. The service is
called once; the last bound charges only that abstract classical call. -/
theorem exists_classicalQuery_resource_bound (F G : UniformOracleCircuitFamily)
    {L t : ℕ → ℕ} (hL : PolynomiallyBounded L) (ht : PolynomiallyBounded t) :
    ∃ B : ℕ → ℕ, ComputableInPolyTime B encUnary encUnary ∧ PolynomiallyBounded B ∧
      ∀ n ℓ, ℓ ≤ L n →
        let first := F.description n ℓ
        let next := G.description n (t n)
        first.width + next.width ≤ B n ∧
        first.instructions.gateCount + next.instructions.gateCount ≤ B n ∧
        first.instructions.queryCount + next.instructions.queryCount ≤ B n ∧
        (encOracleCircuitDescription first).length +
          (encOracleCircuitDescription next).length ≤ B n ∧
        t n ≤ B n ∧ 1 ≤ B n := by
  obtain ⟨B₁, hB₁, hp₁, hb₁⟩ := F.exists_computable_resource_bound hL
  obtain ⟨B₂, hB₂, hp₂, hb₂⟩ := G.exists_computable_resource_bound ht
  have hB : ComputableInPolyTime (fun n => B₁ n + B₂ n + 1) encUnary encUnary := by
    fun_prop
  refine ⟨fun n => B₁ n + B₂ n + 1, hB, hB.polynomiallyBounded, ?_⟩
  intro n ℓ hℓ
  dsimp only
  have hf := hb₁ n ℓ hℓ
  have hfTotal := (F.description n ℓ).width_add_length_le_encoding_length.trans hf
  have hg := hb₂ n (t n) le_rfl
  have hgTotal := (G.description n (t n)).width_add_length_le_encoding_length.trans hg
  have hfit := (G.wellFormed n (t n)).input_le
  dsimp only at hfit
  have hc₁ := OracleCircuit.gateCount_add_queryCount (F.description n ℓ).instructions
  have hc₂ := OracleCircuit.gateCount_add_queryCount
    (G.description n (t n)).instructions
  omega

end Cslib.Quantum.UniformOracleCircuitFamily
