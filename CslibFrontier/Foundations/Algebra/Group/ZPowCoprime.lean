module
-- upstream: candidate (Mathlib, `Mathlib/Data/Int/GCD.lean`)

public import CslibFrontier.Init
public import Mathlib.Algebra.Group.Commute.Basic
public import Mathlib.RingTheory.Coprime.Basic

/-!
# Common roots of group elements with coprime integer exponents

Let `a` and `b` be commuting elements of a group with `a ^ m = b ^ n`, and let `m * s + n * t = 1`.
Then `c = b ^ s * a ^ t` satisfies `c ^ m = b` and `c ^ n = a`, and it is the only element that
does. No condition on the order of the group or of `a` and `b` is needed. This is what
distinguishes the statement from Mathlib's `powCoprime`, which inverts `x ↦ x ^ k` for `k` coprime
to the order of a finite group.

This is the identity that makes the output of the algorithm in Theorem 10.6 of [BonehShoup2023]
("Shamir's trick", p. 416) correct, in any group: from `w ^ e = y ^ f` for units `w`, `y` modulo
`n` and coprime `e`, `f`, that algorithm computes the `e`-th root `y ^ s * w ^ t` of `y`, where
`e * s + f * t = 1`, without knowing the order of `(ℤ/nℤ)ˣ`. The algorithm on encoded inputs and
its running time are not part of this file.

The characterization `Commute.zpow_eq_zpow_iff_of_isCoprime` is the counterpart, for groups and
integer exponents, of Mathlib's `Commute.pow_eq_pow_iff_of_coprime` for groups with zero and
natural exponents. Integer exponents matter in the applications: Bézout coefficients have mixed
signs, and the book applies the result with a possibly negative exponent.

## Main results

* `Commute.zpow_mul_zpow_zpow_eq_right`, `Commute.zpow_mul_zpow_zpow_eq_left`: for commuting `a`,
  `b` with `a ^ m = b ^ n` and `m * s + n * t = 1`, `(b ^ s * a ^ t) ^ m = b` and
  `(b ^ s * a ^ t) ^ n = a`.
* `eq_zpow_mul_zpow_of_zpow_eq`: if `c ^ m = b`, `c ^ n = a` and `m * s + n * t = 1`, then
  `c = b ^ s * a ^ t`, with no commutativity hypothesis.
* `Commute.zpow_eq_zpow_iff_of_isCoprime`, `zpow_eq_zpow_iff_of_isCoprime`: for coprime `m`, `n`
  and commuting `a`, `b` (or in a commutative group), `a ^ m = b ^ n` if and only if `a` and `b`
  are the `n`-th and `m`-th powers of one element.

Each has an additive version generated by `to_additive`.

## References

* [D. Boneh, V. Shoup, *A Graduate Course in Applied Cryptography*, Version 0.6][BonehShoup2023],
  Theorem 10.6, p. 416.
-/

public section

section Group

variable {α : Type*} [Group α] {a b c : α} {m n s t : ℤ}

/-- If `a` and `b` commute, `a ^ m = b ^ n` and `m * s + n * t = 1`, then `b ^ s * a ^ t` is an
`m`-th root of `b`. -/
@[to_additive /-- If `a` and `b` commute, `m • a = n • b` and `m * s + n * t = 1`, then
`s • b + t • a` is an element whose `m`-th multiple is `b`. -/]
theorem Commute.zpow_mul_zpow_zpow_eq_right (hab : Commute a b) (hst : m * s + n * t = 1)
    (h : a ^ m = b ^ n) : (b ^ s * a ^ t) ^ m = b := by
  rw [(hab.symm.zpow_zpow s t).mul_zpow, ← zpow_mul, ← zpow_mul, mul_comm t m, zpow_mul a m t, h,
    ← zpow_mul, ← zpow_add, mul_comm s m, hst, zpow_one]

/-- If `a` and `b` commute, `a ^ m = b ^ n` and `m * s + n * t = 1`, then `b ^ s * a ^ t` is an
`n`-th root of `a`. -/
@[to_additive /-- If `a` and `b` commute, `m • a = n • b` and `m * s + n * t = 1`, then
`s • b + t • a` is an element whose `n`-th multiple is `a`. -/]
theorem Commute.zpow_mul_zpow_zpow_eq_left (hab : Commute a b) (hst : m * s + n * t = 1)
    (h : a ^ m = b ^ n) : (b ^ s * a ^ t) ^ n = a := by
  rw [(hab.symm.zpow_zpow s t).mul_zpow, ← zpow_mul, ← zpow_mul, mul_comm s n, zpow_mul b n s, ← h,
    ← zpow_mul, ← zpow_add, mul_comm t n, hst, zpow_one]

/-- If `c ^ m = b`, `c ^ n = a` and `m * s + n * t = 1`, then `c = b ^ s * a ^ t`. In particular
an element with these two powers is unique, and `b ^ s * a ^ t` does not depend on the choice of
`s` and `t`. No commutativity hypothesis is needed. -/
@[to_additive /-- If `m • c = b`, `n • c = a` and `m * s + n * t = 1`, then `c = s • b + t • a`.
In particular an element with these two multiples is unique, and `s • b + t • a` does not depend
on the choice of `s` and `t`. -/]
theorem eq_zpow_mul_zpow_of_zpow_eq (hst : m * s + n * t = 1) (hb : c ^ m = b) (ha : c ^ n = a) :
    c = b ^ s * a ^ t := by
  rw [← hb, ← ha, ← zpow_mul, ← zpow_mul, ← zpow_add, hst, zpow_one]

/-- For commuting `a`, `b` and coprime integers `m`, `n`, `a ^ m = b ^ n` if and only if `a` and
`b` are the `n`-th and `m`-th powers of one element. This is the group, integer-exponent
counterpart of `Commute.pow_eq_pow_iff_of_coprime`. -/
@[to_additive /-- For commuting `a`, `b` and coprime integers `m`, `n`, `m • a = n • b` if and
only if `a` and `b` are the `n`-th and `m`-th multiples of one element. -/]
protected theorem Commute.zpow_eq_zpow_iff_of_isCoprime (hab : Commute a b)
    (hmn : IsCoprime m n) : a ^ m = b ^ n ↔ ∃ c, a = c ^ n ∧ b = c ^ m := by
  refine ⟨fun h => ?_, by rintro ⟨c, rfl, rfl⟩; rw [← zpow_mul, ← zpow_mul, mul_comm]⟩
  obtain ⟨s, t, hst⟩ := hmn
  have hst' : m * s + n * t = 1 := by rw [mul_comm m, mul_comm n]; exact hst
  exact ⟨b ^ s * a ^ t, (hab.zpow_mul_zpow_zpow_eq_left hst' h).symm,
    (hab.zpow_mul_zpow_zpow_eq_right hst' h).symm⟩

end Group

section CommGroup

variable {α : Type*} [CommGroup α] {a b : α} {m n : ℤ}

/-- In a commutative group, for coprime integers `m`, `n`, `a ^ m = b ^ n` if and only if `a` and
`b` are the `n`-th and `m`-th powers of one element. -/
@[to_additive /-- In a commutative additive group, for coprime integers `m`, `n`, `m • a = n • b`
if and only if `a` and `b` are the `n`-th and `m`-th multiples of one element. -/]
theorem zpow_eq_zpow_iff_of_isCoprime (hmn : IsCoprime m n) :
    a ^ m = b ^ n ↔ ∃ c, a = c ^ n ∧ b = c ^ m :=
  (Commute.all a b).zpow_eq_zpow_iff_of_isCoprime hmn

end CommGroup
